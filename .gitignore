# dependencies live in the npm workspace one level up (resources/node_modules); never here.
# The Postgres driver is bundled into server/db_pg.js by `npm run build:server` (DESIGN §33), so the
# resource root must never get a package.json — the server's yarn builder would run on it.
node_modules/
ui/node_modules/
ui/storybook-static/
ui/.storybook/cache/
# Built by `node ui/tests/build-fixtures.mjs` (DESIGN §38.15): the fixture plugins' ui/dist trees,
# the imported benchmark baseline and the patched shells bench.mjs serves. All generated, never
# committed — `ui/tests/fixtures/**` holds the sources.
ui/tests/.fixtures-dist/
# `coreUI()` generates the Tailwind entry and a per-plugin Vite cache next to a plugin's sources.
ui/tests/fixtures/*/ui/.core-ui/
# runtime artefacts
data/*
*.log
.yarn.installed
yarn.lock
.DS_Store
!data/.gitkeep
